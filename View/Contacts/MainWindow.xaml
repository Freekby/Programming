<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Contacts"
        xmlns:ViewModel="clr-namespace:View.ViewModel" x:Class="Contacts.MainWindow"
        mc:Ignorable="d"
        Title="Contacts" Height="533" Width="628">
    <Window.DataContext>
        <ViewModel:MainVM/>
    </Window.DataContext>
    <Grid Margin="15">
        <Grid.Resources>
            <Style TargetType="{x:Type Label}">
                <Setter Property="Margin" Value="3"/>
            </Style>
            <Style TargetType="{x:Type TextBox}">
                <Setter Property="Margin" Value="3"/>
            </Style>
            <Style TargetType="{x:Type Button}">
                <Setter Property="Margin" Value="3"/>
            </Style>
            <Style TargetType="{x:Type GroupBox}">
                <Setter Property="Margin" Value="3"/>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions >
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <GroupBox Header="Edit Contact" Grid.Row="0" Grid.Column="0">
            <StackPanel>
                <Label Content="Name:"/>
                <TextBox x:Name="NameTextBox" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Content="Phone number:"/>
                <TextBox x:Name="PhoneNumberTextBox" Text="{Binding PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Content="Email:"/>
                <TextBox x:Name="EmailTextBox" Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </GroupBox>
        <GroupBox Header="Read Contact" Grid.Row="0" Grid.Column="1">
            <StackPanel>
                <Label Content="Name:"/>
                <Label x:Name="NameLabel" Content="{Binding Name}"/>

                <Label Content="Phone number:"/>
                <Label x:Name="PhoneNumberLabel" Content="{Binding PhoneNumber}"/>

                <Label Content="Email:"/>
                <Label x:Name="EmailLabel" Content="{Binding Email}"/>
            </StackPanel>
        </GroupBox>

        <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right">
            <Button x:Name ="SaveButton" Content="Save" Height="25" Width="75" Command="{Binding SaveCommand, Mode=OneWay}" CommandParameter="{Binding Contact}"/>
            <Button x:Name ="LoadButton" Content="Load" Height="25" Width="75" Command="{Binding LoadCommand, Mode=OneWay}"/>
        </StackPanel>
    </Grid>
</Window>
